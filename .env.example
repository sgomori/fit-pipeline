# fit-pipeline configuration
# Copy this file to .env and fill in your values.
# Variables without defaults are required for the indicated mode.
#
# Middleware gating: every variable under "Analytics" below is read by
# StandardAnalyticsProcessor, and EXCLUDE_FIELDS is read by both the parser
# (streams) and FieldFilterProcessor (activity). Both processors are enabled by
# default in PROCESSOR_CHAIN in processors.py; remove one there and its
# variables stop having any effect.

# ---------------------------------------------------------------------------
# Webhook delivery (required unless DRY_RUN=true or OUTPUT_FILE is set)
#
# A JSON array of destinations, each with its own URL and bearer secret.
# The payload is delivered to every destination (host:port go in the URL).
# Example with two destinations:
#   WEBHOOK_DESTINATIONS=[{"url":"https://app.example.com/hook","secret":"sk_a"},{"url":"https://logs.example.com/in","secret":"sk_b"}]
# ---------------------------------------------------------------------------
WEBHOOK_DESTINATIONS=[{"url":"https://your-app.example.com/webhooks/activity","secret":"your_secret_here"}]

# ---------------------------------------------------------------------------
# HTTP server (required only when running server.py)
# ---------------------------------------------------------------------------
# Bearer token for /process and /upload. server.py exits 1 without it.
SERVER_SECRET=your_server_secret_here
# Listen port. The server always binds 0.0.0.0.
SERVER_PORT=8000
# Directory for POST /upload files. Unset, /upload returns 503; /process is
# unaffected either way.
UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Field filtering
# ---------------------------------------------------------------------------
# Drop position_lat/position_long from the stream data. The activity summary
# is built from a fixed field list that has never included coordinates, so this
# gates the streams only.
EXCLUDE_GPS=true

# Device serial, manufacturer, product, hardware/software version, device index.
# These are already absent from every payload: the activity summary is an
# allow-list of analytical fields and none of them are on it. The variable is
# read into config but currently gates nothing — leaving it true documents the
# intent and matches the delivered payload.
EXCLUDE_DEVICE_INFO=true

# Comma-separated field names to drop. Applied in two places: the parser drops
# matching stream keys, and FieldFilterProcessor drops matching keys from both
# activity and streams in the payload.
#   EXCLUDE_FIELDS=temperature_celsius,average_cadence
EXCLUDE_FIELDS=

# ---------------------------------------------------------------------------
# Stream data
# ---------------------------------------------------------------------------
INCLUDE_STREAMS=true               # Include time-series stream arrays in payload
STREAM_SAMPLE_RATE=3               # Seconds between stream samples (1 = full resolution)

# ---------------------------------------------------------------------------
# Output mode
# ---------------------------------------------------------------------------
DRY_RUN=false                      # Parse and process without delivering; output to stdout
# Write payload to this file path instead of POSTing
OUTPUT_FILE=

# ---------------------------------------------------------------------------
# Completed-file naming
# ---------------------------------------------------------------------------
# strftime pattern applied to files moved into completed/, using the activity's
# LOCAL start time. The original filename stem is always appended, so
# "%Y-%m-%d-%H%M" turns 463372454903.fit into
# 2026-07-25-1136_463372454903.fit — chronologically sortable, activity ID kept.
# Renaming is idempotent: a file already carrying its own start-date prefix is
# left as-is, so reprocessing one does not stack a second date onto the name.
# A file in completed/ is never overwritten. If the target name is taken, the
# received name is used instead; if that is taken too, the move is skipped and
# the file stays put with a WARNING — it will be reprocessed on the next run
# until you clear the collision by hand.
# Leave empty (the default) to keep the filename exactly as received.
COMPLETED_FILENAME_FORMAT=

# Set the completed file's modification time to the instant the activity
# started, so `ls -t` and a file manager's date column agree with the filename.
# Independent of the setting above — either can be used without the other.
# Note this discards the record of when the file arrived, and that mtime is an
# absolute instant: an activity recorded in another timezone displays in yours.
COMPLETED_SET_MTIME=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Log file path; logs to stdout only if empty
LOG_FILE=

# ---------------------------------------------------------------------------
# Analytics — LTHR and heart rate zones
#
# THRESHOLD_HR is used for TSS (hrTSS) and HR zone boundaries when no LTHR
# is present in the FIT file's zones_target message. If both are absent,
# tss_score and hr_zone_distribution return null.
#
# THRESHOLD_HR and MAX_HR must be 80-220 BPM; anything else fails at startup.
# The same band is applied to the FIT file's own values, which are treated as
# absent when outside it — a watch that has never auto-detected a threshold
# reports 0 rather than omitting the field.
#
# HR_ZONE_1 through HR_ZONE_4 set fixed BPM upper boundaries, overriding the
# LTHR-percentage defaults. All four must be set for the override to apply —
# a partial set is ignored and the LTHR percentages are used for every zone,
# so that the boundaries always come from one consistent source.
#
# Leave them empty to use the LTHR-based defaults (Joe Friel's running zones,
# compressed to 5 buckets):
#   Zone 1: < 85% LTHR    (Active Recovery)
#   Zone 2: 85–89% LTHR   (Aerobic)
#   Zone 3: 90–99% LTHR   (Tempo)
#   Zone 4: 100–106% LTHR (Threshold)
#   Zone 5: > 106% LTHR   (VO2max / Neuromuscular)
#
# Zone boundaries still require a usable LTHR even when overridden, because
# hr_zone_distribution is null without one.
# ---------------------------------------------------------------------------
# Lactate threshold HR in BPM (static fallback)
THRESHOLD_HR=
# BPM upper boundary of Zone 1
HR_ZONE_1=
# BPM upper boundary of Zone 2
HR_ZONE_2=
# BPM upper boundary of Zone 3
HR_ZONE_3=
# BPM upper boundary of Zone 4
HR_ZONE_4=
# Zone 5 is unbounded above, so it has no boundary to set. This variable is
# loaded but never read; it is kept so the five zones read as a complete set.
HR_ZONE_5=

# ---------------------------------------------------------------------------
# Analytics — pace zones (s/km upper boundaries)
# pace_zone_distribution returns null only if none of the three are set. Set
# some but not all and the metric is still produced: a sample that no
# configured boundary claims falls through to "easy", so a partial set
# silently inflates that bucket. Set all three or none.
#   easy:      comfortable conversational pace
#   moderate:  aerobic effort, slightly harder than easy
#   threshold: at or near lactate threshold pace
#   hard:      above threshold (remainder)
# ---------------------------------------------------------------------------
# s/km upper boundary (e.g. 360 = 6:00/km)
PACE_ZONE_EASY=
# s/km upper boundary (e.g. 330 = 5:30/km)
PACE_ZONE_MODERATE=
# s/km upper boundary (e.g. 300 = 5:00/km)
PACE_ZONE_THRESHOLD=

# ---------------------------------------------------------------------------
# Analytics — rTSS (run Training Stress Score from Normalized Graded Pace)
# rtss_score returns null if THRESHOLD_PACE is not set. hrTSS (tss_score)
# remains available as the HR-only fallback.
# ---------------------------------------------------------------------------
# functional threshold pace, s/km (e.g. 300 = 5:00/km)
THRESHOLD_PACE=

# ---------------------------------------------------------------------------
# Analytics — TRIMP (Banister's Training Impulse)
# trimp returns null if RESTING_HR is not set.
# max_hr is sourced from MAX_HR config first, then the FIT file session value.
# ---------------------------------------------------------------------------
# Resting heart rate in BPM
RESTING_HR=
# Max HR override (FIT session value used if absent)
MAX_HR=
TRIMP_GENDER=male                  # male | female (affects Banister exponential coefficients)
